{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --proxy-config proxy.conf.js",
    "start:docker": "ng serve --host 0.0.0.0 --poll=2000 --proxy-config proxy.conf.js",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:open": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless && npx cypress run --config baseUrl=http://localhost:4200",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "e2e": "cypress run --config baseUrl=http://localhost:4200",
    "storybook": "ng run frontend:storybook",
    "build-storybook": "ng run frontend:build-storybook"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.0",
    "@angular/cdk": "^20.2.14",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/platform-server": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/ssr": "^20.3.0",
    "@swimlane/ngx-charts": "^23.1.0",
    "dazzle-icons": "^1.0.7",
    "express": "^5.2.1",
    "picmo": "^5.8.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "typescript": "~5.9.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2003.0",
    "@angular-devkit/build-angular": "^20.3.0",
    "@angular-devkit/core": "^20.3.0",
    "@angular/build": "^20.3.8",
    "@angular/cli": "^20.0.6",
    "@angular/compiler-cli": "^20.3.0",
    "@angular/platform-browser-dynamic": "^20.3.0",
    "@compodoc/compodoc": "^2.0.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-onboarding": "^10.4.6",
    "@storybook/angular": "^10.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.19",
    "esbuild": "^0.28.1",
    "storybook": "^10.4.6",
    "typescript": "~5.9.2"
  }
}
